   "source": [
    "n=5\n",
    "i=1\n",
    "\n",
    "while i<= n:\n",
    "    if i == 1:\n",
    "        print(\"\"* (n-i)+ \"*\")\n",
    "    else:\n",
    "        print(\"\"* (n-i)+ \"*\" + \"\" * (2*i-3)+\"*\")\n",
    "    i+=1\n",
    "    i=n-1\n",
    "while i>=1:\n",
    "    if i ==1:\n",
    "        print(\"\"*(n-i)+\"*\")\n",
    "    else:\n",
    "        print(\"\"*(n-i)+\"*\"+\"\"*(2*i-3)+\"*\")\n",
    "    i-=1"
   ]
